# BASE chain RPC URL (default: https://mainnet.base.org)
BASE_RPC_URL=https://mainnet.base.org

# Optional: Load wallet from private key instead of wallet.json
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: KyberSwap client identifier (shown in analytics)
KYBERSWAP_CLIENT_ID=swaptest-bot

# Optional: 1inch API key (required when using --aggregator 1inch)
# Get yours at https://portal.1inch.dev/
# ONEINCH_API_KEY=your_api_key_here
